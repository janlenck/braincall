{
  // Example configuration for BrainCall. Every setting is listed here with its default or a sample value.
  // Comments (//, /* */) and a trailing comma before ] or } are allowed.
  //
  // ============================================================================================
  //  WHERE THE CONFIGURATION LIVES: real file vs. pointer
  // ============================================================================================
  //  The program (start.bat, test-call.bat) always starts with config.json in the project folder.
  //  There are two ways to use it:
  //
  //  A) Simple: copy this file to config.json in the project folder and fill it in.
  //     Careful: config.json is tracked by git (it normally holds only a pointer, see B).
  //     Never commit it with keys in it.
  //
  //  B) Recommended: keep the real configuration outside the project, e.g. in OneDrive.
  //     It is backed up, survives a fresh clone or reinstall, and the keys never end up in git.
  //     1. Copy this file to e.g.  C:\Users\Name\OneDrive\braincall\config.json
  //        and fill it in there. That is the real configuration.
  //     2. config.json in the project folder then contains ONLY the pointer, nothing else:
  //          { "path": "C:\\Users\\Name\\OneDrive\\braincall\\config.json" }
  //        - Backslashes doubled as in normal JSON. Single backslashes ("C:\Users\…") are accepted too.
  //        - Environment variables and ~ are expanded, e.g.
  //            { "path": "%OneDrive%\\braincall\\config.json" }
  //        - If the referenced file does not exist, the program stops with an error message
  //          (it does NOT silently fall back to defaults).
  //        - At startup the log shows which file was actually loaded ("Config: …").
  //     The pointer contains no secrets and may be committed; that is how this repository does it.
  //
  //  Instead of the pointer file, the environment variable BRAINCALL_CONFIG can hold the path
  //  of the real configuration. It takes precedence over config.json in the project folder.
  //
  //  Secrets can also come from environment variables. If set, they override the value in the file:
  //    ANTHROPIC_API_KEY, OPENAI_API_KEY, HA_TOKEN, BRAINCALL_SIP_PASSWORD, BRAINCALL_API_TOKEN
  //
  //  Settings that are missing from the file use the default from app/config.py.
  // ============================================================================================

  // --- FRITZ!Box / SIP (Telephony -> Telephony Devices -> new IP phone) ---
  "sip_server": "192.168.178.1",      // IP address of the FRITZ!Box
  "sip_port": 5060,
  "sip_user": "IP_PHONE_USERNAME",    // user name of the IP phone in the FRITZ!Box
  "sip_password": "",                 // or environment variable BRAINCALL_SIP_PASSWORD
  "local_ip": "",                     // IP of this computer; empty = detect automatically
  "sip_local_port": 5062,             // if changed: adjust firewall.ps1 as well
  "rtp_port_min": 30000,              // UDP port range for audio, see firewall.ps1
  "rtp_port_max": 30100,

  // --- Who calls / who gets called ---
  "default_number": "0151xxxxxxx",    // target of the test call (key A, test-call.bat), grants no rights
  // Who may call and what they may do. Not listed = rejected; "*" = everyone else; withheld numbers are
  // always rejected. The same list applies when the agent calls someone (not listed = guest).
  // access (several possible, as list or "a, b"):
  //   admin    everything: read and control Home Assistant, appointments
  //   read     read everything (states, sensors, appointments with details), change nothing
  //   calendar only free/busy times (no details), books appointments in free slots without asking you
  //   shopping only the shopping list(s) from shopping_lists
  //   guest    no access at all, takes a message
  // instructions: extra instructions for the assistant for this caller (optional)
  // language: fixed language for this caller (optional, otherwise "language")
  // notify: send the summary after the call (optional; default: everyone except admin)
  // web: may search the web (optional; default: admin and read when web_access is on; never for "*")
  "callers": [
    { "number": "0151xxxxxxx", "name": "Jan Mobile", "access": "admin" },  // first word of name = address
    { "number": "**611", "name": "Jan Internal", "access": "admin" },     // internal FRITZ!Box numbers work too
    { "number": "0171xxxxxxx", "name": "Walter", "access": "read" },
    { "number": "0170xxxxxxx", "name": "Maryna", "access": "calendar", "language": "uk",
      "instructions": "May ask whether Jan is at home in the next 7 days; if free, book her wish date titled \"Maryna comes\"." },
    { "number": "0160xxxxxxx", "name": "Shopper", "access": ["shopping", "calendar"], "web": true },
    { "number": "*", "name": "Unknown", "access": "guest" }
  ],
  "notify_services": [],              // summary after incoming calls, e.g. ["notify.mobile_app_phone", "notify.email"]
  "shopping_lists": ["todo.shopping_list"],  // the only lists callers with access "shopping" may use
  "country_code": "49",               // +49 / 0049 count as the same number as a leading 0
  "ring_timeout": 90,                 // seconds to ring before an unanswered outbound call is cancelled

  // --- Claude ---
  "anthropic_api_key": "",            // or environment variable ANTHROPIC_API_KEY
  "claude_model": "claude-haiku-5-5",
  "assistant_name": "Claudine",       // name the assistant introduces itself with
  "owner_name": "Jan Lenck",          // whose assistant this is; the first name is used in conversations
  "language": "de",                   // "de", "uk", "en" or "auto" (answers in the language spoken last)
  "extra_prompt": "",                 // additional instructions appended to the system prompt
  "timezone": "Europe/Berlin",        // for "today", "tomorrow" etc.

  // --- OpenAI speech recognition / voice ---
  "openai_api_key": "",               // or environment variable OPENAI_API_KEY
  "stt_model": "gpt-4o-transcribe",
  "tts_model": "gpt-4o-mini-tts",
  "tts_voice": "nova",                // e.g. alloy, ash, coral, echo, nova, onyx, sage, shimmer
  "tts_instructions": "Speak natural German, cheerful and lively, brisk pace like on the phone.",

  // --- Voice activity detection ---
  "vad_min_energy": 500,              // minimum loudness that counts as speech
  "end_silence_ms": 450,              // silence after which an utterance is considered finished
  "speculative_ms": 300,              // after this pause STT and Claude already start; spoken only once the pause
                                      // reaches end_silence_ms, dropped if the caller goes on (0 = off)
  "silence_timeout": 12,              // seconds without speech before asking; twice in a row = hang up
  "barge_in": true,                   // caller may interrupt the assistant
  "barge_in_min_ms": 1000,            // how long the caller must speak to interrupt
  "fillers": true,                    // short "Hmm…", "Moment, ich schau kurz nach" … while the answer is prepared
  "filler_delay_ms": 600,             // filler only if the answer has no audio this long after the caller stopped
  "still_working_s": 5,               // "Ich bin noch dran" after this many seconds of silence on our side; 0 = off

  // --- Logs and call notes ---
  "log_dir": "",                      // empty = logs\ in the project folder; environment variables allowed
  "caller_memory": "none",            // summaries of earlier calls per number as context in the next call:
                                      // "none" (off), days like 30 (only that recent) or "forever"; in calls.jsonl

  // --- HTTP trigger for outbound calls ---
  "http_port": 8099,                  // if changed: adjust firewall.ps1 as well
  "api_token": "",                    // empty = only reachable from 127.0.0.1; set = reachable in the LAN
                                      // with "Authorization: Bearer <api_token>" (env BRAINCALL_API_TOKEN)

  // --- Home Assistant (empty ha_url/ha_token = no Home Assistant) ---
  "ha_url": "https://homeassistant:8123",
  "ha_token": "",                     // long-lived access token, or environment variable HA_TOKEN
  "ha_verify_ssl": true,              // true/false or path to the CA certificate (.crt/.pem)
  "default_calendars": ["calendar.xyz", "holiday"],  // entity_ids or name parts; [] = all calendars
  "all_day_free_words": ["gelber sack", "abfall"],  // all-day entries with these words in the title are free
                                      // (Home Assistant does not pass on Google's "free"/"busy")
  "calendar_write": true,             // callers with access admin/calendar may create appointments
  "calendar_max_hours": 4,            // callers without admin: longest booking (all-day: one day); 0 = no limit
  "calendar_max_days_ahead": 90,      // callers without admin: how far ahead they may book; 0 = no limit
  "calendar_max_bookings": 2,         // callers without admin: appointments per call; 0 = no limit
  "control_domains": ["light", "switch", "fan", "input_boolean", "scene", "script", "climate",
                      "media_player", "cover", "button", "number", "select", "todo"],  // [] = control nothing
  "confirm_domains": ["cover", "lock", "alarm_control_panel"],  // ask for an explicit "yes" first

  // --- Planned calls with a task ("Ruf im Restaurant an und reservier einen Tisch"), see README ---
  "tasks": true,                      // admins may plan calls on the phone (plan_call) and via POST /tasks
  "task_max_retries": 3,              // most further attempts a task may ask for if nobody is reached
  "task_retry_minutes": 15,           // pause between attempts
  "outbound_hours": "09:00-20:00",    // planned calls only in this time of day; "" = any time
  "outbound_max_calls_per_day": 20,   // planned calls (attempts) per day; 0 = no limit
  "outbound_blocked": ["110", "112", "118", "0137", "019", "0900"],  // never dialed, also not via /call
  "outbound_allowed_regex": "",       // only numbers matching it (national form), e.g. "0[1-9][0-9]{5,12}"

  // --- Web search (Anthropic's web_search / web_fetch: $10 per 1,000 searches plus tokens) ---
  "web_access": false,                // on: callers with access admin/read (or "web": true) may look things up
  "web_max_searches": 3,              // searches per answer; 0 = no limit
  "web_max_fetches": 2,               // pages read per answer; 0 = no limit
  "web_max_searches_per_day": 50,     // all calls together (logs\web-usage.json); 0 = no limit
  "web_max_fetches_per_day": 50,
  "web_max_content_tokens": 8000,     // longer pages are cut off; 0 = no limit
  "web_allowed_domains": [],          // only these sites, e.g. ["bahn.de"]; or:
  "web_blocked_domains": [],          // never these sites (ignored if web_allowed_domains is set)
  "web_city": "",                     // for local results, e.g. "Mölln"
  "web_country": ""                   // two letters, e.g. "DE"
}
