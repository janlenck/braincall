{
  // Copy to config.json and fill in.
  // Comments (//, /* */) and a trailing comma before ] or } are allowed.
  //
  // Tip: the real configuration can live elsewhere (e.g. OneDrive, so it is backed up and keys never
  // end up in git). Then config.json in the project folder only holds a pointer (backslashes as-is):
  //   { "path": "C:\Users\Name\OneDrive\claude-telefon\config.json" }
  // Alternatively set the environment variable CLAUDE_TELEFON_CONFIG to that path.

  // --- FRITZ!Box / SIP (create an IP phone in the FRITZ!Box) ---
  "sip_server": "192.168.178.1",
  "sip_port": 5060,
  "sip_user": "IP_PHONE_USERNAME",
  "sip_password": "",                 // or environment variable CLAUDE_TELEFON_SIP_PASSWORD
  "local_ip": "",                     // empty = detect automatically
  "sip_local_port": 5062,
  "rtp_port_min": 30000,
  "rtp_port_max": 30100,

  // --- Who calls / who gets called ---
  "default_number": "0151xxxxxxx",    // target of the test call, grants no rights
  "inbound_allowed": ["*"],           // ["*"] = accept all, [] = only trusted_numbers, or a list of numbers
                                      // (withheld numbers are always rejected)
  "trusted_numbers": {                // only these numbers may query and control Home Assistant
    "0151xxxxxxx": "Jan Mobile",
    "**611": "Jan Internal"
  },
  "country_code": "49",               // +49 / 0049 count as the same number as a leading 0
  "caller_languages": {},             // language per number, e.g. { "0170xxxxxxx": "uk" }
  "ring_timeout": 90,

  // --- Claude ---
  "anthropic_api_key": "",            // or environment variable ANTHROPIC_API_KEY
  "claude_model": "claude-haiku-5-5",
  "assistant_name": "Claudine",
  "owner_name": "Jan Lenck",          // whose assistant this is; the first name is used in conversations
  "language": "de",                   // "de", "uk", "en" or "auto"
  "extra_prompt": "",

  // --- OpenAI speech recognition / voice ---
  "openai_api_key": "",               // or environment variable OPENAI_API_KEY
  "stt_model": "gpt-4o-transcribe",
  "tts_model": "gpt-4o-mini-tts",
  "tts_voice": "nova",
  "tts_instructions": "Speak natural German, cheerful and lively, brisk pace like on the phone.",

  // --- Voice activity detection ---
  "vad_min_energy": 500,
  "end_silence_ms": 700,
  "silence_timeout": 12,
  "barge_in": true,
  "barge_in_min_ms": 1000,            // how long the caller must speak to interrupt

  // --- Logs and call notes (empty = logs\ in the project folder) ---
  "log_dir": "",

  // --- HTTP trigger for outbound calls ---
  "http_port": 8099,
  "api_token": "",                    // empty = only reachable from 127.0.0.1

  // --- Home Assistant ---
  "ha_url": "https://homeassistant:8123",
  "ha_token": "",                     // or environment variable HA_TOKEN
  "ha_verify_ssl": true,
  "default_calendars": ["calendar.xyz", "holiday"],
  "calendar_write": true
  // control_domains / confirm_domains: see app/config.py
}
